      <bt:LongStrings>
        <bt:String id="GetStarted.Description" DefaultValue="Open TQ Connector on the Home tab, then type =TQ.BALANCE( in any cell."/>
        <bt:String id="Button.Tooltip" DefaultValue="Refresh balances, drill down and insert NetSuite lists."/>
        <bt:String id="T.Panel" DefaultValue="Show the TQ Connector panel."/>
        <bt:String id="T.NewReport" DefaultValue="Build a report step by step: what, which periods, filters and sheets."/>
        <bt:String id="T.Chat" DefaultValue="Ask for a report or a number in your own words, or change a report with a short follow-up."/>
        <bt:String id="T.RefreshAll" DefaultValue="Recalculate every TQ formula in the workbook."/>
        <bt:String id="T.RefreshSheet" DefaultValue="Recalculate only the active sheet."/>
        <bt:String id="T.RefreshSelection" DefaultValue="Recalculate only the selected cells."/>
        <bt:String id="T.Drill" DefaultValue="Show the accounts or transactions behind the selected cell."/>
        <bt:String id="T.Formula" DefaultValue="Pick an account, period and filters; the formula goes into the selected cell."/>
        <bt:String id="T.Values" DefaultValue="Copy the report (or its whole pack) with the numbers fixed, for people without the add-in."/>
        <bt:String id="T.Pdf" DefaultValue="Landscape, one page wide, company logo and name, title and page numbers on the pack."/>
        <bt:String id="T.Ctx" DefaultValue="Drill down, refresh or insert a NetSuite formula here."/>
        <bt:String id="T.Dashboard" DefaultValue="A dashboard sheet: key figures as tiles and Excel charts over live NetSuite numbers, rolling with the month."/>
      </bt:LongStrings>
